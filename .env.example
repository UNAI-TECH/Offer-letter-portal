# Supabase Public Configuration (Safe for frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Edge Functions URL (if invoking functions directly via custom domain or Supabase functions gateway)
VITE_SUPABASE_FUNCTIONS_URL=https://your-project-id.supabase.co/functions/v1

# Admin Credentials (for initial setup documentation, never commit real credentials)
# Supabase Service Role Key is ONLY used inside Supabase Edge Functions environment and database setup scripts
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to frontend code!

